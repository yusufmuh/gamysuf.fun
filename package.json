{
  "name": "gamysuf-arcade",
  "version": "1.1.0",
  "description": "Gamysuf Arcade: satu dashboard untuk tiga game booth Bpedia (Spin Wheels, Nyapit, Bipy Beauty Drop) plus slot game tambahan, berjalan di cloud (Hostinger Node.js).",
  "author": "Muhammad Yusuf",
  "private": true,
  "main": "hub/server.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node hub/server.cjs",
    "dev": "node hub/server.cjs --local",
    "sync": "node scripts/sync-games.cjs",
    "test": "node --test tests/*.test.cjs",
    "qa": "node scripts/capture.cjs",
    "qa:responsive": "node scripts/responsive-qa.cjs",
    "package:hostinger": "node scripts/package-hostinger.cjs"
  },
  "dependencies": {
    "fflate": "0.8.3"
  }
}
